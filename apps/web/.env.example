# Frontend env (public). NEVER put service-account or service-role keys here (Section 14).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# When unset, the dashboard serves the typed mock data layer so every screen is viewable.
NEXT_PUBLIC_USE_MOCK=true
