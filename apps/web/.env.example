# Frontend env (public). NEVER put service-account or service-role keys here (Section 14).

# Live data: set to "false" and point at the deployed NestJS API to leave demo/mock mode.
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Supabase (anon key only — public). Enables real auth + authenticated API calls.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (NOT public). When set, the app reads real delegate rosters from
# Supabase on the server — this is what makes real data show on the deployed site.
# Set these in Vercel as Environment Variables (not NEXT_PUBLIC_*).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Landing image: drop the real NDC creative at apps/web/public/landing.png and set true.
NEXT_PUBLIC_USE_LANDING_IMAGE=false
